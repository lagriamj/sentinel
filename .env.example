# Copy to .env and replace both passwords before starting the stack.
# Passwords must be at least 16 characters and use only letters, numbers,
# underscores, and hyphens. These placeholders are rejected on startup.

POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=sentinel

REDIS_PASSWORD=change-me-local-only

# At least 32 characters, with no spaces. The placeholder is rejected.
# Generate a value and do not commit the real secret.
API_AUTH_SECRET=change-me-local-only-auth-secret-value

API_ENVIRONMENT=development
SCANNER_ENVIRONMENT=development

# The API process reads these names. Compose sets them inside the containers.
# Replace the passwords before using the URLs to run the API on the host.
API_HTTP_ADDR=:8080
API_DATABASE_URL=postgres://sentinel:change-me-local-only@localhost:5432/sentinel?sslmode=disable
API_REDIS_URL=redis://:change-me-local-only@localhost:6379/0

# Host port for the local reverse proxy. 8080 is already used by another
# Docker project on some machines; change this if the bind fails.
API_HOST_PORT=8080
